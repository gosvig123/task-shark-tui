      "labelAt": [800, 198]
    },
    {
      "id": "app-storage",
      "from": "app",
      "to": "store",
      "label": "save app state",
      "labelAt": [750, 430],
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "workspace-storage",
      "from": "pi",
      "to": "workspace",
      "label": "session and task work",
      "labelAt": [1080, 430],
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "id": "board-extension",
      "from": "pi",
      "to": "board",
      "label": "task and Board tools",
      "fromSide": "top",
      "toSide": "right"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "App boundary",
      "items": ["The terminal app owns navigation and review state.", "Native SQLite owns tasks and Board Updates."]
    },
    {
      "dot": "emerald",
      "title": "Task and conversation scope",
      "items": ["Today derives from local task dates; edits and midnight refresh it.", "Each Task-backed Conversation has a fixed Agent Workspace."]
    },
    {
      "dot": "violet",
      "title": "Agent integration",
      "items": ["Pi runs beneath the app through RPC.", "Task tools use fixed IDs; conversation briefs stay snapshots."]
    }
  ]
