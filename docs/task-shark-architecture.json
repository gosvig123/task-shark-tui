      "size": [200, 64]
    },
    {
      "id": "board",
      "type": "backend",
      "label": "Scoped Task Tools",
      "sublabel": "Fixed task and conversation IDs",
      "pos": [860, 120],
      "size": [190, 64]
    },
    {
      "id": "store",
      "type": "database",
      "label": "Local App Storage",
      "sublabel": "Conversations, preferences, lock",
      "pos": [540, 500],
      "size": [200, 64]
    },
    {
      "id": "workspace",
      "type": "database",
      "label": "Agent Workspace",
      "sublabel": "Workspace and Pi session",
      "pos": [860, 500],
      "size": [190, 64]
    }
  ],
  "connections": [
    {
      "id": "user-input",
      "from": "user",
      "to": "tui",
      "label": "keyboard input and previews",
      "labelAt": [210, 390],
      "variant": "emphasis"
    },
    {
      "id": "interface-state",
      "from": "tui",
      "to": "app",
      "label": "commands and state changes",
      "labelAt": [490, 390],
      "variant": "emphasis"
    },
    {
      "id": "pi-rpc",
      "from": "app",
      "to": "pi",
      "label": "conversation and request protocol",
      "labelAt": [800, 390],
      "variant": "emphasis"
    },
    {
      "id": "task-api",
      "from": "app",
      "to": "tasks",
